# Copie para .env e preencha os valores locais.
# Nunca versione o .env com valores reais.

# Banco local (libSQL/SQLite) ou URL do Turso
DATABASE_URL=file:dev.db

# Token do Turso (deixe vazio para banco local)
TURSO_AUTH_TOKEN=

# Segredo usado pela rota /api/fetch-news e pelo admin
SECRET_KEY=troque-por-um-segredo-forte-e-unico
